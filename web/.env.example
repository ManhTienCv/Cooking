# Site key reCAPTCHA v3 (public) — trùng cặp với RECAPTCHA_SECRET_KEY trên API
# https://www.google.com/recaptcha/admin
# Google Sign-In Client ID (Public)
VITE_GOOGLE_CLIENT_ID=

# URL API backend — để trống khi chạy local (Vite proxy xử lý)
# Trên Vercel: đặt = URL backend thật, ví dụ: https://your-api.onrender.com
VITE_API_URL=
