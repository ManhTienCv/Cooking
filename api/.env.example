PORT=3001
NODE_ENV=development
# Postgresql
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Dev DB bootstrap (npm run db:setup / npm run dev runs this automatically)
# ADMIN_EMAIL=admin@cook.local
# ADMIN_PASSWORD=Admin@Cook123456
# DB_FORCE=1          # re-apply migrations + seed
# DB_SKIP_SEED=1      # schema only, no demo users

SESSION_SECRET=replace-with-long-random-secret

# Comma-separated origins for CORS (browser dev server)
CORS_ORIGIN=http://localhost:5173

# AI (multi-provider — thử lần lượt Gemini → Groq → OpenRouter)
AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# CookingWeb — gửi OTP (Gmail: 2FA + App Password)
MAIL_BRAND=CookingWeb
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CookingWeb <your-email@gmail.com>
OTP_EMAIL_MODE=auto
# TEST_OTP_CODE=000000

#BREVO
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
MAIL_PROVIDER=brevo

# reCAPTCHA v2 — sau 3 lần đăng nhập sai (user + admin) cần checkbox. Tạo tại https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
